---
import type { TypeInProgressEntrySkeleton } from '@cezar/contentful-types';
import type { Entry } from 'contentful';
import ProgressBar from '~/components/react/ProgressBar';

interface Props { entry: Entry<TypeInProgressEntrySkeleton> }
const { entry } = Astro.props;
const f = entry.fields;
const title = f.title as string;
const expectedCompletion = f.expectedCompletion as string;
const shortDescription = f.shortDescription as string;
const progressPercent = f.progressPercent as number;
---
<div class="bg-white/[0.08] p-5">
  <div class="text-[11px] opacity-70">Ukończenie {expectedCompletion}</div>
  <div class="mt-1 font-bold">{title}</div>
  <p class="mt-2 text-xs opacity-80">{shortDescription}</p>
  <div class="mt-3"><ProgressBar client:visible percent={progressPercent} /></div>
  <div class="mt-2 text-[11px] opacity-70">{progressPercent}%</div>
</div>
