---
import type { TypeProcessStepSkeleton } from '@cezar/contentful-types';
import type { Entry } from 'contentful';
import CountUp from '~/components/react/CountUp';

interface Props { step: Entry<TypeProcessStepSkeleton> }
const { step } = Astro.props;
const number = step.fields.number as number;
const title = step.fields.title as string;
const description = step.fields.description as string;
---
<div>
  <div class="font-extrabold leading-none text-[var(--color-accent-soft)] text-5xl md:text-6xl">
    <CountUp client:visible to={number} />
  </div>
  <div class="mt-2 font-bold">{title}</div>
  <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">{description}</p>
</div>
